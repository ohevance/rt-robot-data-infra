# 실물 보드(Pi) 에이전트의 접속 설정 — ~/.config/rt-fleet/fleet.env 로 복사해 값을 채운다 (이 파일은 예시, 비밀값 없음)
# 값은 관제 서버의 ~/fleet-server-info.txt 에서 (deploy/ec2/setup.sh 가 만든다). WSL 브로커를 쓸 때는 FLEET_BROKER 만 LAN 주소로 두고 나머지는 비운다.
FLEET_BROKER=
FLEET_PORT=8883
FLEET_TLS_CA=/home/<user>/fleet-ca.crt
FLEET_USER=fleet
FLEET_PASS=
# 자율 업데이트: 정식 릴리스만 보는 'latest' 주소. 확인 주기(초)와 허용 시간대(예: 3-5 = 03~05시)
MANIFEST_URL=https://github.com/<owner>/<repo>/releases/latest/download/manifest.json
POLL_S=600
WINDOW=3-5
