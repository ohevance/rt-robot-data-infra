<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rt_control_ros2</name>
  <version>0.1.0</version>
  <description>Thin ROS 2 adapter around rt_core: 1 kHz RT control loop, lock-free command/state rings, watchdog, step limiter.</description>
  <maintainer email="ohevance@gmail.com">Moongu Oh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rmw</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
